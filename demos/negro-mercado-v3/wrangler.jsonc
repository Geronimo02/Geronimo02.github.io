{
  "name": "negro-mercado-v3",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "negro-mercado", "database_id": "REEMPLAZAR-con-wrangler-d1-create" }
  ]
}
