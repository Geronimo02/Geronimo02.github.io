---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Recorte from './Recorte.astro';
import Pending from './Pending.astro';
import type { Recorte as RecorteName } from '../lib/menu';

interface Props {
  /** Foto real; si falta, se muestra el placeholder con la ilustración. */
  src?: ImageMetadata;
  alt: string;
  /** Qué foto hay que pedir, p. ej. "pasta en pan, primer plano, 4:5". */
  brief: string;
  ratio?: string;
  recorte?: RecorteName;
  sizes?: string;
  priority?: boolean;
  class?: string;
}
const { src, alt, brief, ratio = '4 / 5', recorte, sizes = '(min-width: 960px) 50vw, 100vw', priority = false, class: className } = Astro.props;
---
<figure class:list={['photo-slot', className]} style={`--ratio:${ratio}`}>
  {src ? (
    <Image src={src} alt={alt} widths={[480, 800, 1200, 1600]} sizes={sizes} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} />
  ) : (
    <div class="ph mantel mantel--soft">
      {recorte && <Recorte name={recorte} alt={alt} priority={priority} class="ph-recorte" sizes="(min-width: 960px) 420px, 70vw" />}
      <figcaption><Pending note={`Foto original: ${brief}`} /> <span>Foto: {brief}</span></figcaption>
    </div>
  )}
</figure>

<style>
  .photo-slot { margin: 0; aspect-ratio: var(--ratio); overflow: hidden; border-radius: var(--radius-sm); position: relative; background: var(--paper); }
  .photo-slot > :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ph { position: absolute; inset: 0; display: grid; place-items: center; }
  .ph :global(.ph-recorte) { width: min(78%, 420px); height: auto; filter: drop-shadow(0 18px 0 rgba(59, 23, 25, .12)); }
  figcaption {
    position: absolute; left: 12px; right: 12px; bottom: 12px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px;
    background: var(--cream); padding: 8px 12px; border-radius: var(--radius-sm);
    font-size: .8125rem; line-height: 1.35;
  }
</style>
