---
import { Image } from 'astro:assets';
import { foto, FOTO_ALT, type FotoName } from '../lib/fotos';

interface Props {
  name: FotoName;
  /** alt="" para fotos decorativas; si se omite se usa la descripción de la foto. */
  alt?: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
  style?: string;
  position?: string;
}
const { name, alt = FOTO_ALT[name], sizes = '(min-width: 960px) 50vw, 100vw', widths = [480, 800, 1200, 1600], priority = false, class: className, style, position = 'center' } = Astro.props;
const src = foto(name);
---
{src && (
  <Image
    src={src}
    alt={alt}
    widths={widths}
    quality={72}
    sizes={sizes}
    class={className}
    style={`object-position:${position};${style ?? ''}`}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
  />
)}
