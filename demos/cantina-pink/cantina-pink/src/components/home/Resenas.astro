---
import Pending from '../Pending.astro';
import reviewsData from '../../data/reviews.json';
import { business } from '../../lib/hours';

interface Review { name: string; date: string; stars: number; text: string; url?: string }
const reviews = (reviewsData.reviews as Review[]).filter((r) => r.name && r.text);
const tilts = [-2.5, 1.8, -1.2, 2.6, -2, 1.4];
const colors = ['#FFE08A', '#FFC9C0', '#C9E4C5', '#FFE08A', '#D8E4F5', '#FFC9C0'];
---
{reviews.length > 0 ? (
  <section class="rv" aria-labelledby="rv-title">
    <div class="container">
      <header class="head">
        <p class="kicker">Lo que dicen</p>
        <h2 id="rv-title" class="display-l">Gente que ya se sentó a la mesa.</h2>
      </header>
      <ul class="notes">
        {reviews.map((r, i) => (
          <li class="note" style={`--tilt:${tilts[i % tilts.length]}deg; --bg:${colors[i % colors.length]}`} data-reveal="pop">
            <p class="stars" aria-label={`${r.stars} de 5 estrellas`}><span aria-hidden="true" style="display:contents">{Array.from({ length: 5 }, (_, k) => <span class={k < Math.max(0, Math.min(5, r.stars)) ? 'icon-star' : 'icon-star-empty'}></span>)}</span></p>
            <blockquote>“{r.text}”</blockquote>
            <p class="who">{r.name} · <time>{r.date}</time></p>
            {r.url && <a href={r.url} target="_blank" rel="noopener">Ver reseña</a>}
          </li>
        ))}
      </ul>
      {reviewsData.sourceUrl && <p class="src"><a href={reviewsData.sourceUrl} target="_blank" rel="noopener">{reviewsData.sourceLabel}</a></p>}
    </div>
  </section>
) : business.showPendingMarkers ? (
  <section class="rv rv--empty" aria-label="Reseñas (pendiente)">
    <div class="container">
      <div class="empty">
        <Pending label="COMPLETAR" note="Pegar reseñas reales de Google con nombre y fecha en src/data/reviews.json." />
        <p>Acá van las reseñas reales de Google, como notas adhesivas, con nombre y fecha. Sin reseñas cargadas esta sección no se muestra al público.</p>
      </div>
    </div>
  </section>
) : null}

<style>
  .rv { padding: 72px 0; }
  .head { display: grid; gap: 12px; margin-bottom: 36px; max-width: 18ch; }
  .notes { list-style: none; display: grid; gap: 22px; }
  .note { background: var(--bg); color: var(--ink); padding: 22px 20px 18px; border: 2.5px solid var(--ink); border-radius: 4px; box-shadow: 5px 5px 0 var(--ink); rotate: var(--tilt); display: grid; gap: 10px; align-content: start; transition: rotate var(--motion-long) var(--ease-out), transform var(--motion-long) var(--ease-out); }
  .note:hover { rotate: 0deg; transform: translateY(-4px); }
  .stars { color: var(--wine); font-size: 1.125rem; display: flex; gap: .15em; }
  blockquote { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 1.1875rem; line-height: 1.3; }
  .who { font-weight: 700; font-size: .875rem; }
  .src { margin-top: 24px; font-weight: 700; }
  @media (min-width: 640px) { .notes { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .notes { grid-template-columns: repeat(3, 1fr); } .head { max-width: none; } }
  .rv--empty { padding: 40px 0; }
  .empty { display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: center; padding: 18px 20px; border: 2.5px dashed var(--line-strong); border-radius: var(--radius-sm); font-size: .9375rem; }
  
</style>
