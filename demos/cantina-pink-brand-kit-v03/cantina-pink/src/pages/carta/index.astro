---
import Base from '../../layouts/Base.astro';
import MenuCategory from '../../components/MenuCategory.astro';
import Pending from '../../components/Pending.astro';
import Carrito from '../../components/Carrito.tsx';
import { menu } from '../../lib/menu';
import { business } from '../../lib/hours';

const cats = menu.categories.map((c) => ({ c, items: c.items }));
---
<Base title="La carta" description="Carta de Cantina Pink en Tandil: pizzas, milanesas XL, pastas, empanadas, picadas, postres y bebidas. Armá tu pedido y mandalo por WhatsApp para retirar o con delivery.">
  <section class="container carta-head">
    <p class="kicker">La carta</p>
    <h1 class="display-xl">Mirá la carta. Después hablamos de compartir.</h1>
    <p class="how">Sumá lo que quieras, elegí <strong>retiro o delivery</strong> y mandá el pedido por WhatsApp. El pago es en persona.</p>
    {!menu.verified && <p class="warn"><Pending note="Carta y precios de ejemplo hasta cargar la carta oficial." /> Carta y precios de ejemplo.</p>}
    <nav aria-label="Categorías">
      <ul class="chips">
        {cats.map(({ c }) => <li><a href={`#cat-${c.id}`}>{c.name}</a></li>)}
      </ul>
    </nav>
  </section>

  <div class="container carta-body">
    <div class="list">
      {cats.map(({ c, items }, i) => <MenuCategory category={c} items={items} index={i} photos ordering />)}
    </div>
    <aside id="pedido" class="pedido-col" aria-label="Tu pedido">
      <Carrito client:load wa={business.whatsapp.e164} />
    </aside>
  </div>
  <p class="toast" data-toast role="status" aria-live="polite"></p>
  <script>
    import '../../scripts/carta.ts';
  </script>
</Base>

<style>
  .carta-head { padding: 48px 0 24px; display: grid; gap: 18px; }
  .carta-head h1 { max-width: 14ch; }
  .warn { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font-size: .875rem; }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: var(--radius-pill); border: 1.5px solid var(--ink); font-weight: 700; text-decoration: none; }
  .chips a:hover { background: var(--wine); color: var(--cream); border-color: var(--wine); }
  .carta-body { display: grid; gap: 40px; padding-bottom: 96px; }
  .how { max-width: 52ch; font-size: 1.0625rem; }
  .pedido-col { min-width: 0; }
  .toast {
    position: fixed; left: 0; right: 0; margin-inline: auto; width: max-content; bottom: 92px; translate: 0 12px; z-index: 40; max-width: calc(100vw - 24px); text-align: center;
    padding: 10px 18px; border-radius: var(--radius-pill); background: var(--ink); color: var(--cream); font-weight: 700; font-size: .9375rem;
    opacity: 0; pointer-events: none; transition: opacity var(--motion-short), translate var(--motion-long) var(--ease-out);
  }
  .toast.is-on { opacity: 1; translate: 0 0; }
  @media (prefers-reduced-motion: reduce) { .toast { transition: none; } }
  @media (min-width: 960px) {
    .carta-body { grid-template-columns: 1fr 410px; gap: 48px; }
    .pedido-col { margin-top: 40px; }
  }
</style>
