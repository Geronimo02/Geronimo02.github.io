---
import promosData from '../data/promos.json';

// Los datos viajan en el HTML y el navegador decide cuál mostrar según la fecha (el sitio es estático).
const promos = (promosData as { promos: unknown[] }).promos;
---
<div class="promo" data-promo data-promos={JSON.stringify(promos)} hidden role="region" aria-label="Promoción">
  <p class="promo-text">
    <span class="promo-preview" data-promo-preview hidden>Vista previa</span>
    <strong data-promo-title></strong> <span data-promo-body></span>
  </p>
  <a class="promo-cta" data-promo-cta href="/carta"></a>
  <button type="button" class="promo-close" data-promo-close aria-label="Cerrar promoción">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
</div>

<style>
  .promo { position: relative; z-index: 21; background: var(--red); color: var(--cream); border-bottom: 3px solid var(--ink); display: flex; align-items: center; gap: 12px 16px; flex-wrap: wrap; padding: 10px calc(var(--gutter) + 40px) 10px var(--gutter); justify-content: center; text-align: center; }
  .promo[hidden] { display: none; }
  .promo-text { font-size: .9375rem; line-height: 1.4; max-width: 78ch; }
  .promo-text strong { font-family: var(--font-display); font-weight: 800; font-size: 1.0625rem; }
  .promo-preview { display: inline-block; margin-right: 8px; padding: 1px 8px; border: 2px dashed var(--cream); border-radius: var(--radius-sm); font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .promo-preview[hidden] { display: none; }
  .promo-cta { display: inline-flex; align-items: center; min-height: 36px; padding: 0 16px; border-radius: var(--radius-pill); background: var(--cream); color: var(--wine); border: 2px solid var(--ink); font-weight: 700; text-decoration: none; box-shadow: 2px 2px 0 var(--ink); }
  .promo-cta:hover { background: var(--paper); }
  .promo-close { position: absolute; right: calc(var(--gutter) - 8px); top: 50%; translate: 0 -50%; width: 44px; height: 44px; display: grid; place-items: center; background: transparent; color: inherit; border: 0; cursor: pointer; border-radius: 50%; }
  .promo-close:hover { background: rgba(255, 247, 233, .18); }
  .promo :global(a:focus-visible), .promo :global(button:focus-visible) { outline-color: var(--cream); }
</style>
