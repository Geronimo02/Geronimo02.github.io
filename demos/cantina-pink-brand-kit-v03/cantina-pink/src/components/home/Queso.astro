---
import Foto from '../Foto.astro';
import Icon from '../Icon.astro';
---
<section class="qs placa on-dark" data-queso aria-labelledby="qs-title">
  <div class="container qs-grid">
    <div class="stage">
      <div class="plate" aria-hidden="true">
        <div class="layer l0"><Foto name="pasta-3-salsa" alt="" low widths={[400, 640, 900]} sizes="(min-width: 960px) 460px, 80vw" /></div>
        <div class="layer l1" data-queso-l1 style="opacity:.9"><Foto name="pasta-4-queso" alt="" low widths={[400, 640, 900]} sizes="(min-width: 960px) 460px, 80vw" /></div>
        <div class="layer l2" data-queso-l2 style="opacity:0"><Foto name="pasta-5-montana" alt="" low widths={[400, 640, 900]} sizes="(min-width: 960px) 460px, 80vw" /></div>
      </div>
      <p class="sello stamp" data-queso-stamp aria-hidden="true">Demasiado queso</p>
    </div>

    <div class="panel">
      <p class="kicker">Vos mandás</p>
      <h2 id="qs-title" class="display-l">¿Cuánto queso?</h2>

      <div class="ctl">
        <label for="queso-range" class="visually-hidden">Cantidad de queso rallado sobre la pasta en pan</label>
        <input id="queso-range" type="range" min="0" max="100" step="1" value="45" data-queso-range aria-describedby="queso-verdict" />
        <div class="ends" aria-hidden="true"><span>Nada</span><span>Demasiado</span></div>
      </div>

      <p class="grams" aria-hidden="true"><span data-queso-g>135</span> <small>g de queso</small></p>
      <p id="queso-verdict" class="verdict" data-queso-verdict aria-live="polite">Como corresponde.</p>

      <a class="btn btn--cream" href="/carta#plato-pasta-en-pan">Pedir la pasta en pan <Icon name="flecha" size={20} /></a>
    </div>
  </div>
</section>

<script>
  const clamp = (v: number) => Math.min(1, Math.max(0, v));

  function setup() {
    const root = document.querySelector<HTMLElement>('[data-queso]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    const range = root.querySelector<HTMLInputElement>('[data-queso-range]')!;
    const l1 = root.querySelector<HTMLElement>('[data-queso-l1]')!;
    const l2 = root.querySelector<HTMLElement>('[data-queso-l2]')!;
    const grams = root.querySelector<HTMLElement>('[data-queso-g]')!;
    const verdict = root.querySelector<HTMLElement>('[data-queso-verdict]')!;
    const stamp = root.querySelector<HTMLElement>('[data-queso-stamp]')!;
    const plate = root.querySelector<HTMLElement>('.plate')!;

    const words = (v: number) =>
      v < 10 ? 'Sin queso. Respetamos, pero no entendemos.'
      : v < 35 ? 'Un toque, para no abusar.'
      : v < 65 ? 'Como corresponde.'
      : v < 90 ? 'Se te fue la mano. Nos gusta.'
      : 'NO. Bueno, era un poco menos.';

    let last = '';
    const update = () => {
      const v = Number(range.value);
      l1.style.opacity = String(clamp(v / 50));
      l2.style.opacity = String(clamp((v - 50) / 50));
      grams.textContent = String(Math.round(v * 3));
      const w = words(v);
      if (w !== last) { verdict.textContent = w; last = w; }
      const over = v >= 90;
      stamp.classList.toggle('is-on', over);
      plate.classList.toggle('shake', over);
      range.style.setProperty('--fill', `${v}%`);
    };
    range.addEventListener('input', update);
    update();
  }
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .qs { padding: 72px 0; overflow: hidden; }
  .qs-grid { display: grid; gap: 40px; align-items: center; }
  .stage { position: relative; display: grid; place-items: center; }
  .plate { position: relative; width: min(82vw, 440px); aspect-ratio: 1; border-radius: 50%; overflow: hidden; border: 6px solid var(--cream); box-shadow: 0 14px 0 rgba(0, 0, 0, .32); background: var(--paper); }
  .layer { position: absolute; inset: 0; }
  .layer :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .plate.shake { animation: temblar 380ms linear infinite; }
  @keyframes temblar { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-1.4deg) translateX(-2px); } 75% { transform: rotate(1.4deg) translateX(2px); } }
  .stamp { position: absolute; right: 4%; bottom: 6%; z-index: 3; font-size: 1.0625rem; opacity: 0; scale: .5; transition: opacity 200ms, scale 420ms cubic-bezier(.34, 1.56, .64, 1); }
  .stamp.is-on { opacity: 1; scale: 1; }

  .panel { display: grid; gap: 18px; justify-items: start; max-width: 34rem; }
  .ctl { width: 100%; display: grid; gap: 6px; }
  .ends { display: flex; justify-content: space-between; font-size: .875rem; font-weight: 700; }
  .grams { font-family: var(--font-display); font-weight: 800; font-size: clamp(3rem, 8vw, 5rem); line-height: .9; }
  .grams small { font-family: var(--font-body); font-size: 1rem; font-weight: 700; }
  .verdict { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.375rem, 3vw, 1.875rem); line-height: 1.15; min-height: 2.4em; max-width: 22ch; }

  input[type='range'] { --fill: 45%; -webkit-appearance: none; appearance: none; width: 100%; height: 44px; background: transparent; cursor: pointer; }
  input[type='range']::-webkit-slider-runnable-track { height: 16px; border-radius: 99px; border: 2.5px solid var(--cream); background: linear-gradient(90deg, var(--cream) var(--fill), transparent var(--fill)); }
  input[type='range']::-moz-range-track { height: 11px; border-radius: 99px; border: 2.5px solid var(--cream); background: transparent; }
  input[type='range']::-moz-range-progress { height: 11px; border-radius: 99px; background: var(--cream); }
  input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; width: 40px; height: 40px; margin-top: -14px; border-radius: 50%; background: var(--cream); border: 3px solid var(--ink); box-shadow: 3px 3px 0 var(--ink); }
  input[type='range']::-moz-range-thumb { width: 34px; height: 34px; border-radius: 50%; background: var(--cream); border: 3px solid var(--ink); box-shadow: 3px 3px 0 var(--ink); }
  input[type='range']:focus-visible { outline: 3px solid var(--cream); outline-offset: 4px; border-radius: 99px; }

  @media (min-width: 960px) { .qs-grid { grid-template-columns: 1fr 1fr; gap: 72px; } .stage { justify-self: center; } }
  @media (prefers-reduced-motion: reduce) { .plate.shake { animation: none; } .stamp { transition: none; } }
</style>
