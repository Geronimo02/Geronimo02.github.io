---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Foto from '../components/Foto.astro';
---
<Base title="OG" noindex lite>
  <div class="og">
    <div class="left placa">
      <Logo variant="a" height={150} eager />
      <p class="title">Hay lugar para todos en la mesa.</p>
      <p class="sub">San Martín 501 · Tandil</p>
    </div>
    <div class="right mantel">
      <div class="plato pz"><Foto name="pizza-jamon-rucula" alt="" priority widths={[600, 900]} sizes="380px" /></div>
      <div class="plato pa"><Foto name="pasta-3-salsa" alt="" priority widths={[480, 800]} sizes="300px" /></div>
      <div class="plato mi"><Foto name="milanesa-caballo" alt="" position="70% 62%" priority widths={[480, 800]} sizes="320px" /></div>
    </div>
  </div>
</Base>

<style>
  :global(.skip-link) { display: none; }
  .og { width: 1200px; height: 630px; display: grid; grid-template-columns: 560px 640px; overflow: hidden; }
  .left { padding: 56px; display: flex; flex-direction: column; gap: 24px; }
  .left :global(.logo) { height: 150px; width: auto; align-self: flex-start; }
  .title { font-family: var(--font-display); font-weight: 800; font-size: 76px; line-height: .95; letter-spacing: -.02em; margin-top: auto; }
  .sub { font-weight: 700; font-size: 24px; letter-spacing: .08em; text-transform: uppercase; }
  .right { position: relative; --cell: 40px; }
  .plato { position: absolute; aspect-ratio: 1; border-radius: 50%; overflow: hidden; border: 8px solid var(--cream); box-shadow: 0 16px 0 rgba(59, 23, 25, .3); background: var(--paper); }
  .plato :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .pz { width: 380px; left: 150px; top: 36px; z-index: 2; }
  .pa { width: 300px; left: -40px; top: 330px; }
  .mi { width: 320px; left: 380px; top: 340px; }
</style>
