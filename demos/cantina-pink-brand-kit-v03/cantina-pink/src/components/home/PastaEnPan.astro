---
import Foto from '../Foto.astro';
import Icon from '../Icon.astro';
import type { FotoName } from '../../lib/fotos';

interface Paso { foto: FotoName; kicker: string; titulo: string; nota?: string }
const pasos: Paso[] = [
  { foto: 'pasta-1-vacio', kicker: 'Paso 1', titulo: 'Un pan. Vacío.', nota: 'Todavía no hay nada adentro. Alguien tiene que hacerse cargo.' },
  { foto: 'pasta-2-pasta', kicker: 'Paso 2', titulo: 'Agregale la pasta.', nota: 'Fideos tirados, al dente, con perejil.' },
  { foto: 'pasta-3-salsa', kicker: 'Paso 3', titulo: 'Ahora la salsa.', nota: 'Sin miedo. El pan sabe lo que hace.' },
  { foto: 'pasta-4-queso', kicker: 'Paso 4', titulo: 'Y queso. Ahora sí, a disfrutar.', nota: 'Esto ya se puede comer.' },
  { foto: 'pasta-5-montana', kicker: 'Paso 5', titulo: 'No. Bueno, era un poco menos.', nota: 'Pedí queso como si nadie te mirara.' },
];
---
<section class="pp" data-pasta aria-labelledby="pp-title">
  <div class="pp-sticky mantel">
    <div class="pp-copy">
      <p class="kicker">Pasta en pan</p>
      <h2 id="pp-title" class="display-l">Armá tu pasta en pan.</h2>
      <div class="pp-captions" aria-live="polite">
        {pasos.map((p, i) => (
          <div class:list={['cap', i === 0 && 'is-active']} data-pasta-cap={i}>
            <p class="cap-kicker">{p.kicker} de {pasos.length}</p>
            <p class="cap-title">{p.titulo}</p>
            {p.nota && <p class="cap-note">{p.nota}</p>}
          </div>
        ))}
      </div>
      <ol class="dots" aria-hidden="true">
        {pasos.map((_, i) => <li class:list={[i === 0 && 'is-active']} data-pasta-dot={i}></li>)}
      </ol>
      <a class="btn btn--wine" href="/carta#cat-pastas">Ver las pastas <Icon name="flecha" size={20} /></a>
    </div>

    <div class="pp-stage">
      <div class="plate" data-pasta-plate>
        {pasos.map((p, i) => (
          <div class:list={['frame', i === 0 && 'is-active']} data-pasta-frame={i}>
            <Foto name={p.foto} alt={i === 0 ? 'Pan de campo ahuecado que va llenándose de pasta, salsa y queso' : ''} widths={[400, 640, 900]} sizes="(min-width: 960px) 560px, 86vw" />
          </div>
        ))}
      </div>
      <p class="stamp sello" data-pasta-stamp>Demasiado queso</p>
    </div>
  </div>

  <ol class="pp-static">
    {pasos.map((p) => (
      <li>
        <Foto name={p.foto} alt={p.titulo} widths={[320, 520]} sizes="240px" />
        <p class="cap-kicker">{p.kicker}</p>
        <p class="cap-title">{p.titulo}</p>
      </li>
    ))}
  </ol>
</section>

<script>
  function setup() {
    const section = document.querySelector<HTMLElement>('[data-pasta]');
    if (!section || section.dataset.bound) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    section.dataset.bound = '1';
    section.classList.add('is-animated');

    const frames = [...section.querySelectorAll<HTMLElement>('[data-pasta-frame]')];
    const caps = [...section.querySelectorAll<HTMLElement>('[data-pasta-cap]')];
    const dots = [...section.querySelectorAll<HTMLElement>('[data-pasta-dot]')];
    const plate = section.querySelector<HTMLElement>('[data-pasta-plate]')!;
    const stamp = section.querySelector<HTMLElement>('[data-pasta-stamp]')!;
    const n = frames.length;
    let active = -1, raf = 0;

    const set = (i: number) => {
      if (i === active) return;
      active = i;
      frames.forEach((f, k) => f.classList.toggle('is-active', k === i));
      caps.forEach((c, k) => c.classList.toggle('is-active', k === i));
      dots.forEach((d, k) => d.classList.toggle('is-active', k <= i));
      stamp.classList.toggle('is-on', i === n - 1);
      plate.classList.remove('bump'); void plate.offsetWidth; plate.classList.add('bump');
    };

    const update = () => {
      raf = 0;
      const r = section.getBoundingClientRect();
      const total = section.offsetHeight - innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
      set(Math.min(n - 1, Math.floor(p * n * 0.999)));
      plate.style.setProperty('--turn', `${(p * 14 - 4).toFixed(2)}deg`);
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(update); };
    addEventListener('scroll', kick, { passive: true });
    addEventListener('resize', kick);
    update();
  }
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .pp { position: relative; }
  .pp-sticky { position: relative; display: grid; gap: 28px; padding: 56px var(--gutter) 64px; align-items: center; overflow: hidden; }
  .pp-copy { position: relative; z-index: 2; display: grid; gap: 14px; justify-items: start; padding: 22px; background: var(--cream); border: 3px solid var(--ink); border-radius: var(--radius-sm); box-shadow: 8px 8px 0 var(--ink); max-width: 34rem; }
  .pp-copy h2 { font-size: clamp(1.875rem, 4.4vw, 3.25rem); }
  .pp-captions { display: grid; min-height: 9.5rem; width: 100%; }
  .cap { grid-area: 1 / 1; display: grid; align-content: start; gap: 6px; opacity: 0; transform: translateY(10px); transition: opacity var(--motion-short), transform var(--motion-long) var(--ease-out); pointer-events: none; }
  .cap.is-active { opacity: 1; transform: none; pointer-events: auto; }
  .cap-kicker { font-weight: 700; font-size: .8125rem; letter-spacing: .14em; text-transform: uppercase; color: var(--red); }
  .cap-title { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.375rem, 3vw, 2rem); line-height: 1.08; }
  .cap-note { max-width: 36ch; }
  .dots { list-style: none; display: flex; gap: 8px; }
  .dots li { width: 28px; height: 8px; border-radius: 99px; background: var(--line-strong); transition: background var(--motion-short); }
  .dots li.is-active { background: var(--red); }

  .pp-stage { position: relative; display: grid; place-items: center; }
  .plate { position: relative; width: min(86vw, 560px); aspect-ratio: 1; border-radius: 50%; border: 6px solid var(--cream); box-shadow: 0 16px 0 rgba(59, 23, 25, .28); overflow: hidden; background: var(--paper); rotate: var(--turn, 0deg); }
  .frame { position: absolute; inset: 0; opacity: 0; scale: 1.06; transition: opacity 380ms var(--ease-out), scale 700ms var(--ease-out); }
  .frame.is-active { opacity: 1; scale: 1; }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .plate.bump { animation: bump 460ms cubic-bezier(.34, 1.56, .64, 1); }
  @keyframes bump { 0% { transform: scale(.95); } 100% { transform: none; } }
  .stamp { position: absolute; right: 2%; bottom: 4%; z-index: 3; font-size: 1.0625rem; opacity: 0; scale: .5; transition: opacity 200ms, scale 420ms cubic-bezier(.34, 1.56, .64, 1); }
  .stamp.is-on { opacity: 1; scale: 1; }

  /* Sin movimiento: tira de cinco fotos */
  .pp-static { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; padding: 0 var(--gutter) 56px; background: var(--cream); }
  .pp-static li { display: grid; gap: 4px; }
  .pp-static :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 50%; border: 4px solid var(--cream); box-shadow: 0 6px 0 rgba(59, 23, 25, .25); }
  .pp-static .cap-title { font-size: 1.125rem; }

  .pp.is-animated { height: 330vh; }
  .pp.is-animated .pp-sticky { position: sticky; top: 0; height: 100svh; padding-block: 24px; align-content: center; }
  .pp.is-animated .pp-static { display: none; }
  .pp:not(.is-animated) .cap { opacity: 1; transform: none; position: static; }
  .pp:not(.is-animated) .pp-captions, .pp:not(.is-animated) .dots, .pp:not(.is-animated) .pp-stage, .pp:not(.is-animated) .pp-copy .btn { display: none; }
  .pp:not(.is-animated) .pp-copy { max-width: none; box-shadow: none; }

  @media (min-width: 960px) {
    .pp-sticky { grid-template-columns: 5fr 6fr; gap: 56px; padding-inline: max(var(--gutter), calc((100vw - var(--content-width)) / 2)); }
    .pp.is-animated { height: 420vh; }
    .stamp { right: 4%; bottom: 8%; font-size: 1.25rem; }
  }
  @media (max-width: 959px) {
    .pp.is-animated .pp-sticky { align-content: start; padding-top: 16px; gap: 14px; }
    .pp-copy { padding: 16px; box-shadow: 5px 5px 0 var(--ink); gap: 8px; }
    .pp-copy h2 { font-size: 1.625rem; }
    .pp-captions { min-height: 6.4rem; }
    .cap-note { display: none; }
    .plate { width: min(78vw, 46svh); }
  }
  @media (prefers-reduced-motion: reduce) { .frame, .cap, .stamp, .dots li { transition: none; } .plate.bump { animation: none; } }
</style>
